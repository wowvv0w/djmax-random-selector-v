<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="ColorDefault" Color="#7f7f7f"/>
    <SolidColorBrush x:Key="ColorSelected" Color="#ffffff"/>
    <SolidColorBrush x:Key="ColorAccent" Color="#ffbe00"/>
    
    <LinearGradientBrush x:Key="ColorSettingBar" StartPoint="0 .5" EndPoint="1 .5">
        <GradientStop Color="#7f584e46" Offset=".4999"/>
        <GradientStop Color="#ff604e41" Offset=".5"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ColorBackgroundSettingSlider" Color="#44372E"/>

</ResourceDictionary>