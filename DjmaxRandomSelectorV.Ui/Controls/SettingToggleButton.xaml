<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DjmaxRandomSelectorV.Ui.Controls">

    <Style TargetType="{x:Type controls:SettingToggleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingToggleButton}">
                    <ItemsControl Style="{DynamicResource StyleSettingBar}">
                        <ItemsControl.Resources>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </ItemsControl.Resources>
                        <Border Style="{DynamicResource StyleClearBox}"
                                Padding="{DynamicResource PaddingSettingBarLabelArea}">
                            <TextBlock Text="TEST"/>
                        </Border>
                        <ToggleButton Grid.Column="1"
                                      IsChecked="False"
                                      Style="{DynamicResource StyleSettingToggleButton}"/>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>