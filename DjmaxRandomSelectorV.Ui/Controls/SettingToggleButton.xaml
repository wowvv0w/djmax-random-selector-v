<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DjmaxRandomSelectorV.Ui.Controls">

    <Style TargetType="{x:Type controls:SettingToggleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingToggleButton}">
                    <ItemsControl Style="{StaticResource StyleSettingBar}">
                        <ItemsControl.Resources>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </ItemsControl.Resources>
                        <Border Style="{StaticResource StyleClearBox}"
                                Padding="{StaticResource PaddingSettingBarLabelArea}">
                            <TextBlock Text="{Binding Name}"/>
                        </Border>
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding IsOn}"
                                      Style="{StaticResource StyleSettingToggleButton}"/>
                    </ItemsControl>
                                
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>