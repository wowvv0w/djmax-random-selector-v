<UserControl x:Class="DjmaxRandomSelectorV.Views.FilterOptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DjmaxRandomSelectorV.Views"
             xmlns:ui="clr-namespace:DjmaxRandomSelectorV.Ui.Controls;assembly=DjmaxRandomSelectorV.Ui"
             xmlns:cal="http://www.caliburnproject.org"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="{x:Type ui:SettingSpinBox}">
                <Setter Property="IsCircular" Value="True"/>
                <Setter Property="Delay" Value="999999999"/>
                <Setter Property="Interval" Value="999999999"/>
            </Style>
        </Grid.Resources>
        <Border Background="#DF221C15"
                BorderBrush="Gray"
                BorderThickness="0 0 2 0"
                Grid.RowSpan="3" Grid.ColumnSpan="3">
        </Border>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="FILTER OPTION"
                       Style="{StaticResource SettingCategoryText}"/>
            <Grid Style="{x:Null}"
                  Background="#7F584E46"
                  Margin="{DynamicResource MarginSettingBar}"
                  Height="90">
                <ContentControl x:Name="FilterOptionIndicator"
                                Height="55"/>
            </Grid>
            <ui:SettingSlider Label="EXCLUDE RECENT MUSICS"
                              Value="{Binding ExceptCount}"
                              Minimum="0"
                              Maximum="30"
                              TickFrequency="1"
                              IsSnapToTickEnabled="True"/>
            <ui:SettingSpinBox Label="MODE"
                               Value="{Binding ModeValue}"
                               Maximum="{Binding ModeMaxValue}"
                               ValueText="{Binding ModeText}"/>
            <ui:SettingSpinBox Label="AIDER"
                               Value="{Binding AiderValue}"
                               Maximum="{Binding AiderMaxValue}"
                               ValueText="{Binding AiderText}"/>
            <ui:SettingSpinBox Label="LEVEL"
                               Value="{Binding LevelValue}"
                               Maximum="{Binding LevelMaxValue}"
                               ValueText="{Binding LevelText}"/>
        </StackPanel>
    </Grid>
</UserControl>
